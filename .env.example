PORT=3000
NODE_ENV=development

# Configuración de PostgreSQL (Opción A: variables separadas)
DB_USER=postgres
DB_HOST=localhost
DB_NAME=api_db
DB_PASSWORD=tu_contraseña
DB_PORT=5432

# O bien usar URL completa (Opción B: útil para Supabase, Neon, Railway, etc.)
# DATABASE_URL=postgresql://postgres:tu_contraseña@localhost:5432/api_db
